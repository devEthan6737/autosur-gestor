<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefWidth="800.0" prefHeight="500.0" styleClass="root" 
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://fxml.com/fxml/1" 
            fx:controller="com.autosur.controllers.EmployeeController">
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #2c3e50; -fx-padding: 15px;">
            <Label fx:id="lblWelcome" text="Bienvenido, Mecánico" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar Sesión" onAction="#handleLogout" styleClass="button-delete"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Buscar:"/>
                <TextField fx:id="txtSearch" promptText="Buscar por nombre..." onKeyReleased="#handleSearch"/> 
                <Label text="Filtrar por Estado:"/>
                <ComboBox fx:id="cmbFilterStatus" onAction="#handleFilter"/>
            </HBox>
            
            <TableView fx:id="tableTasks" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colTitle" text="Tarea" prefWidth="150"/>
                    <TableColumn fx:id="colDescription" text="Descripción" prefWidth="300"/>
                    <TableColumn fx:id="colStatus" text="Estado" prefWidth="150"/>
                </columns>
            </TableView>
            
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Label text="Cambiar Estado:"/>
                <ComboBox fx:id="cmbChangeStatus"/>
                <Button text="Actualizar Estado" onAction="#handleUpdateStatus"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>